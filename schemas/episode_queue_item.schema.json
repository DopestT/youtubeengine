{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Last 60 Seconds Episode Queue Item",
  "type": "object",
  "required": [
    "episode_id",
    "case_slug",
    "current_status",
    "priority",
    "review_required",
    "approved_to_fire"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "pattern": "^EP[0-9]{3,}$"
    },
    "case_slug": {
      "type": "string"
    },
    "current_status": {
      "type": "string",
      "enum": [
        "NEW_INTAKE",
        "SOURCE_CHECK",
        "TRANSCRIBING",
        "SCORECARD_READY",
        "GREEN_FULL_EPISODE",
        "YELLOW_REVIEW",
        "RED_REJECTED",
        "SHORTS_ONLY",
        "SCRIPT_READY",
        "RUNWAY_ASSETS_READY",
        "EDITOR_READY",
        "REVIEW_READY",
        "APPROVED_TO_FIRE",
        "PUBLISHED"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "URGENT"
      ]
    },
    "assigned_package_folder": {
      "type": "string"
    },
    "raw_video_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agency_source": {
      "type": "string"
    },
    "incident_date": {
      "type": "string"
    },
    "release_date": {
      "type": "string"
    },
    "runtime_raw": {
      "type": "string"
    },
    "public_record_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "copyright_reuse_risk": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "privacy_risk": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "viral_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "full_episode_fit": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "runway_assets_required": {
      "type": "boolean"
    },
    "editor_assets_required": {
      "type": "boolean"
    },
    "review_required": {
      "type": "boolean"
    },
    "approved_to_fire": {
      "type": "boolean",
      "const": false
    },
    "published_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}